	},
	"engines": {
		"node": ">=22.18"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	}
}
